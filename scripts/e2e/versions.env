# Versions for the pinned channel: the lowest Kubernetes this component
# supports. Service account token support for credential providers landed in
# 1.34, so anything below that cannot work whatever the install does.
#
# The latest channel pins nothing and takes each tool's own default, so it
# follows upstream without an edit here.
#
# shellcheck shell=bash
# shellcheck disable=SC2034  # read by the scripts that source this

E2E_PINNED_KIND_NODE_IMAGE="kindest/node:v1.34.11"
E2E_PINNED_K3S_IMAGE="rancher/k3s:v1.34.11-k3s1"
E2E_PINNED_K3S_VERSION="v1.34.11+k3s1"
E2E_PINNED_RKE2_VERSION="v1.34.11+rke2r1"
E2E_PINNED_MICROK8S_CHANNEL="1.34/stable"
E2E_PINNED_K8S_MINOR="v1.34"

# Not part of either channel. kubeadm installs no CNI plugin binaries and
# flannel ships only its own, so the harness supplies the rest at a fixed
# version rather than tracking whatever latest happens to be.
E2E_CNI_PLUGINS_VERSION="v1.9.1"
