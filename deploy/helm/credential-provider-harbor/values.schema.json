{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "credential-provider-harbor values",
  "type": "object",
  "required": [
    "registry",
    "profile",
    "image",
    "installer",
    "credentialProvider",
    "kubelet"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "profile": {
      "description": "Decides the host paths and the kubelet wiring. custom requires credentialProvider.binDir and credentialProvider.configPath.",
      "enum": [
        "generic",
        "eks",
        "aws",
        "k3s",
        "k3d",
        "kind",
        "gke",
        "custom"
      ]
    },
    "registry": {
      "type": "object",
      "required": [
        "host"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "Harbor hostname that workloads pull from. Required."
        },
        "audience": {
          "type": "string"
        },
        "matchImages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cacheDuration": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$",
          "description": "Go duration, as kubelet parses it. 1h, 30m, 1h30m and 1.5h are all valid."
        },
        "username": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "credentialProvider": {
      "type": "object",
      "properties": {
        "binaryName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "description": "Plain filename. The installer rejects a name containing a path separator."
        },
        "binDir": {
          "type": "string",
          "pattern": "^(/.*)?$",
          "description": "Absolute host path, or empty to take the profile default. The installer rejects a relative path."
        },
        "configPath": {
          "type": "string",
          "pattern": "^(/.*)?$",
          "description": "Absolute host path, or empty to take the profile default."
        },
        "configFormat": {
          "enum": [
            "",
            "yaml",
            "json"
          ]
        }
      }
    },
    "installer": {
      "type": "object",
      "properties": {
        "hostRoot": {
          "type": "string",
          "pattern": "^/"
        },
        "sleep": {
          "type": "boolean"
        },
        "installedMarker": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "kubelet": {
      "type": "object",
      "properties": {
        "configure": {
          "type": "boolean"
        },
        "restart": {
          "type": "boolean"
        },
        "serviceName": {
          "type": "string"
        },
        "systemdDropInPath": {
          "type": "string",
          "pattern": "^(/.*)?$"
        },
        "forceExecStartOverride": {
          "type": "boolean"
        },
        "k3sConfigDropInPath": {
          "type": "string",
          "pattern": "^(/.*)?$"
        }
      }
    },
    "nodeAudienceRbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "updateStrategy": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "readinessProbe": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "securityContext": {
      "type": "object"
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "affinity": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "custom"
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "credentialProvider": {
            "required": [
              "binDir",
              "configPath"
            ],
            "properties": {
              "binDir": {
                "pattern": "^/.+"
              },
              "configPath": {
                "pattern": "^/.+"
              }
            }
          }
        }
      }
    }
  ]
}
