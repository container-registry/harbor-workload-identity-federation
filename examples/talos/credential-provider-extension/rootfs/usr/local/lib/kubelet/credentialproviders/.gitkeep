# Place the credential-provider-harbor binary here before building the
# extension image, e.g.:
#
#   CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" \
#     -o examples/talos/credential-provider-extension/rootfs/usr/local/lib/kubelet/credentialproviders/credential-provider-harbor \
#     ./cmd/credential-provider-harbor
#
# Or download a release binary from
# https://github.com/container-registry/harbor-workload-identity-federation/releases
# and chmod 0755 it. The file name (credential-provider-harbor) must match the
# provider "name" in the kubelet CredentialProviderConfig.
